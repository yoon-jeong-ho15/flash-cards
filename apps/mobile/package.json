{
  "name": "@flashcards/mobile",
  "version": "0.1.0",
  "main": "index.js",
  "scripts": {
    "start": "pnpm build:editor && expo start --dev-client",
    "android": "pnpm build:editor && node scripts/android.cjs",
    "ios": "pnpm build:editor && expo run:ios",
    "build:editor": "node scripts/build-editor.cjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build:editor && node --test tests/*.test.cjs",
    "export:check": "pnpm build:editor && expo export --platform ios --platform android --output-dir dist"
  },
  "dependencies": {
    "@flashcards/types": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-google-signin/google-signin": "^16.0.0",
    "@react-native-vector-icons/lucide": "^14.0.0",
    "expo": "~57.0.25",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.19.0",
    "htmlparser2": "^10.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@flashcards/tsconfig": "workspace:*",
    "@tiptap/core": "^2.27.3",
    "@tiptap/extension-highlight": "^2.27.3",
    "@tiptap/extension-image": "^2.27.3",
    "@tiptap/extension-underline": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "57.0.13",
    "dompurify": "^3.2.4",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "lucide": "^1.64.0",
    "typescript": "^5.7.3"
  },
  "private": true
}
