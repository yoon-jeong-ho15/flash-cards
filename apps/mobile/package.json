{
  "name": "@flashcards/mobile",
  "version": "0.1.0",
  "main": "index.js",
  "scripts": {
    "start": "pnpm build:editor && expo start --go",
    "android": "pnpm build:editor && node scripts/android.cjs",
    "ios": "pnpm build:editor && expo run:ios",
    "build:editor": "node scripts/build-editor.cjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build:editor && node --test tests/*.test.cjs",
    "export:check": "pnpm build:editor && expo export --platform ios --platform android --output-dir dist",
    "start:dev-client": "pnpm build:editor && expo start --dev-client"
  },
  "dependencies": {
    "@flashcards/types": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-google-signin/google-signin": "^16.0.0",
    "@react-native-vector-icons/lucide": "^14.0.0",
    "expo": "~58.0.23",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.11",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-status-bar": "~58.0.4",
    "firebase": "^12.19.0",
    "htmlparser2": "^10.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@flashcards/tsconfig": "workspace:*",
    "@tiptap/core": "^2.27.3",
    "@tiptap/extension-highlight": "^2.27.3",
    "@tiptap/extension-image": "^2.27.3",
    "@tiptap/extension-underline": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "58.0.24",
    "dompurify": "^3.2.4",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "lucide": "^1.64.0",
    "typescript": "^6.0.3"
  },
  "private": true
}
