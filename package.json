{
  "name": "flash-cards-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev:web": "turbo run dev --filter=@flashcards/web",
    "dev:mobile": "pnpm --filter @flashcards/mobile start",
    "build:web": "turbo run build --filter=@flashcards/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test:storage": "firebase emulators:exec --project demo-flash-cards-storage --config firebase.storage-test.json --only storage \"node --test tests/storage.rules.test.cjs tests/storage-clients.test.cjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.37.0",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  }
}
